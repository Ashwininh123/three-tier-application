pipeline {
agent any

```
stages {
    stage('Checkout') {
        steps {
            echo 'GitHub repository connected successfully!'
        }
    }

    stage('Build') {
        steps {
            echo 'Build stage started!'
            echo 'Three-tier
 application pipeline is running!'
        }
    }

    stage('Success') {
        steps {
            echo 'Jenkins pipeline completed successfully!'
        }
    }
}
```

}
